{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-mirror.dev/contracts/serial-pose-command.v1.json",
  "title": "Serial pose command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "seq", "yaw_mdeg", "pitch_mdeg", "crc32"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "yaw_mdeg": { "type": "integer", "minimum": -55000, "maximum": 55000 },
    "pitch_mdeg": { "type": "integer", "minimum": -25000, "maximum": 25000 },
    "crc32": { "type": "string", "pattern": "^[0-9A-F]{8}$" }
  }
}
