{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-mirror.dev/contracts/serial-telemetry.v1.json",
  "title": "Serial controller telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "seq", "yaw_mdeg", "pitch_mdeg", "mode", "reason", "armed", "crc32"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "yaw_mdeg": { "type": "integer", "minimum": -55000, "maximum": 55000 },
    "pitch_mdeg": { "type": "integer", "minimum": -25000, "maximum": 25000 },
    "mode": { "enum": ["tracking", "neutral", "stopped"] },
    "reason": { "enum": ["pose", "operator_stop", "operator_arm", "heartbeat_timeout"] },
    "armed": { "type": "boolean" },
    "crc32": { "type": "string", "pattern": "^[0-9A-F]{8}$" }
  }
}
